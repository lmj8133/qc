# Board address, sourced by build.sh and run.sh.
#
# The board's IP is assigned by DHCP and has changed three times so far
# (192.168.3.63 -> .80 -> .67), each time looking exactly like a hung board:
# SSH and ping time out while the stale ARP entry still reads REACHABLE.
# Editing this one line fixes both scripts.
#
# To find the board after it moves, sweep the subnet and look for its MAC:
#   for i in $(seq 1 254); do (ping -c1 -W1 192.168.3.$i >/dev/null 2>&1 &); done
#   sleep 5; ip neigh show | grep -i a0:36:bc:3c:ab:10
# Its hostname is "kalama". A one-off override needs no edit here:
#   BOARD=192.168.3.99 ./run.sh
BOARD_DEFAULT=192.168.3.67
